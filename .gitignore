```gitignore
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
jspm_packages/

# Build output
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
coverage/

# Generated files
*.tsbuildinfo
vite.svg

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Cache
.cache/
.parcel-cache/
.eslintcache

# Package manager files
.pnp
.pnp.js

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/

# Optional lock files (keep if you want reproducible installs)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Firebase
.firebase/

# Vercel
.vercel/

# Netlify
.netlify/

# Docker
docker-compose.override.yml

# Mac metadata
.AppleDouble
.LSOverride
```
